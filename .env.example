# TransitWake Production Environment Configuration Template
# Duplicate this file to .env or set these in EAS Secrets (`npx eas secret:create`)

# ==============================================================================
# 1. Google AdMob (Ad Monetization)
# ==============================================================================
# Obtain from https://admob.google.com -> Apps -> Ad Units
EXPO_PUBLIC_ADMOB_ANDROID_BANNER_ID=ca-app-pub-XXXXXXXXXXXXXXXX/YYYYYYYYYY
EXPO_PUBLIC_ADMOB_ANDROID_INTERSTITIAL_ID=ca-app-pub-XXXXXXXXXXXXXXXX/ZZZZZZZZZZ
EXPO_PUBLIC_ADMOB_IOS_BANNER_ID=ca-app-pub-XXXXXXXXXXXXXXXX/AAAAAAAAAA
EXPO_PUBLIC_ADMOB_IOS_INTERSTITIAL_ID=ca-app-pub-XXXXXXXXXXXXXXXX/BBBBBBBBBB

# ==============================================================================
# 2. In-App Subscriptions & Payments (TransitWake Prime - ₹26/month)
# ==============================================================================
# Option A: RevenueCat (Unified In-App Purchases for Google Play & iOS App Store)
# Obtain from https://app.revenuecat.com -> Project Settings -> API Keys
EXPO_PUBLIC_REVENUECAT_APPLE_KEY=appl_XXXXXXXXXXXXXXXXXXXXXXXXXXXX
EXPO_PUBLIC_REVENUECAT_GOOGLE_KEY=goog_XXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Option B: Direct Web UPI / Card Checkout (for PWA web browser payments)
# Obtain from https://dashboard.razorpay.com -> Settings -> API Keys
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXXXXXXXXXX

# ==============================================================================
# 3. Google OAuth & Authentication (Optional cross-device sync)
# ==============================================================================
# Obtain from Google Cloud Console -> APIs & Credentials -> OAuth 2.0 Client IDs
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=XXXXXXXXXXXX-xxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=XXXXXXXXXXXX-xxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=XXXXXXXXXXXX-xxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# ==============================================================================
# 4. Geocoding & Map Tile CDN (Optional scale upgrades)
# ==============================================================================
# TransitWake uses free OpenStreetMap Nominatim and CartoDB Voyager by default.
# For high-volume production failovers:
EXPO_PUBLIC_LOCATIONIQ_API_KEY=pk.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.eyJ1Ijoi...

# ==============================================================================
# 5. Crash Reporting & Observability (Recommended)
# ==============================================================================
# Obtain from https://sentry.io -> Projects -> Settings -> Client Keys (DSN)
EXPO_PUBLIC_SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@o000000.ingest.sentry.io/0000000
